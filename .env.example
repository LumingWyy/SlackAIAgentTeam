# Slack: Bot User OAuth Token from OAuth & Permissions (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-token

# Slack: Basic Information -> App-Level Tokens, scope connections:write (xapp-...)
SLACK_APP_TOKEN=xapp-your-token

# Anthropic API Key (optional): if the local claude CLI is already logged in (Pro/Max),
# the SDK reuses that login and no API Key is needed. Set only when not logged in.
# Prefer the WebUI Auth tab ("Claude sign-in") for subscription login inside Docker
# (credentials land in the claude-home volume). Use the API key only when not logged in.
ANTHROPIC_API_KEY=sk-ant-your-key

# GitHub token for the container's `gh` CLI (optional). Host `gh auth login` lives in
# the macOS keychain and does not cross into Docker even when ~/.config/gh is mounted.
# Set via WebUI Auth tab (paste or "Import from host gh"), then recreate the container
# (`make up`) so env_file picks it up.
# In a multi-host team every person uses their own local GitHub login/token; never
# copy it to another host. Per-agent OWNER/REPO values belong in agents.yaml and
# contain no credential.
# GH_TOKEN=ghp_your-token

# Claude Code working directory (optional, default = current directory)
CLAUDE_WORKSPACE=/Users/agent/workspace/demo

# Allowlisted Slack users (optional, comma-separated user IDs, e.g. U01ABCDEF)
# Strongly recommended — without this, anyone in the workspace can drive local Claude Code
ALLOWED_SLACK_USERS=

# Local control-plane Bearer tokens. Required automatically when any agent has
# an owner and always required in distributed mode. Use >=32 random printable
# characters. Every local owner is mandatory; a top-level admin token is
# optional per node and grants that admin access only on nodes where it is
# installed. Never copy one shared team token across hosts. The token value
# resolves the Slack principal by itself; identity headers are never trusted.
# Values are loaded into memory and scrubbed before child tools run. The WebUI
# keeps the entered value in sessionStorage only.
# SLACK_AGENT_CONTROL_TOKEN_U01ALICE=replace-with-32-plus-random-characters
# SLACK_AGENT_CONTROL_TOKEN_U01ADMIN=replace-with-32-plus-random-characters

# Thread-state SQLite (sessions / handoff summaries / stats survive restarts)
# Default state.db in the working directory; set empty to disable persistence
# STATE_DB=state.db

# Per-Slack-root-thread Git worktrees. When workspace_mode=thread_worktree,
# all three values are mandatory (YAML worktrees.* takes precedence).
# WORKTREE_ROOT=/absolute/path/outside/the/base/repository
# WORKTREE_BASE_REF=main
# WORKTREE_MAX_PER_REPO=16

# Shared local-first Slack transcript bounds (optional; positive values only).
# All local agents in this process share this cache. Hot/warm threads make no
# conversations.replies call; cold/incomplete threads use cursor pages of <=15.
# TRANSCRIPT_MAX_THREADS=512
# TRANSCRIPT_MAX_MESSAGES_PER_THREAD=50
# TRANSCRIPT_DB_MAX_THREADS=2048
# TRANSCRIPT_MAX_RECORD_BYTES=65536
# TRANSCRIPT_MEMORY_MAX_BYTES=33554432
# TRANSCRIPT_DB_MAX_BYTES=268435456
# Record bytes must be >=256; memory/DB byte caps must each be >= record bytes.
# TRANSCRIPT_TTL_SECONDS=604800
# TRANSCRIPT_RETRY_COOLDOWN_SECONDS=60

# ==== Multi-agent (multi_app.py) ====
# Distributed node identity. It must match agents[].node_id; this determines
# which logical roster entries start on this machine. Keep the same credential-free
# agents.yaml on every host and set a different value locally.
AGENT_NODE_ID=alice-mac

# Hard cap for local Claude/Codex runs when node.max_concurrency is not in YAML.
# At most NODE_MAX_QUEUE additional Slack jobs are admitted; excess is rejected
# with a busy reply. A shared writable workspace is always serialized.
NODE_MAX_CONCURRENCY=2
NODE_MAX_QUEUE=10

# Create a separate Slack App per agent, but set tokens ONLY for agents owned by
# this local node. Never copy Claude/Codex login files, API keys, or another
# person's Slack tokens between hosts.
# Reusing an existing App as dev still requires updating scopes via slack-app-manifest-agent.yaml and reinstalling
# Agent ids containing "/" or "-" are normalized to "_" for default env names.
ALICE_DEV_SLACK_BOT_TOKEN=xoxb-your-local-token
ALICE_DEV_SLACK_APP_TOKEN=xapp-your-local-token
ALICE_REVIEWER_SLACK_BOT_TOKEN=xoxb-your-local-token
ALICE_REVIEWER_SLACK_APP_TOKEN=xapp-your-local-token

# OpenAI Responses API runtime (or OpenAI-compatible local CLI Proxy).
# Keep this only on the owning person's host.
# An agent may point openai_api_key_env at a different local variable name.
# Never place the key itself in agents.yaml.
OPENAI_API_KEY=
# BOB_OPENAI_API_KEY=

# Optional OpenAI-compatible base URL (CLIProxyAPI / Antigravity bridge, etc.).
# When set, the openai runtime talks to this endpoint instead of api.openai.com.
# Example for local CLIProxyAPI (default port 8317):
# OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# Models may then be any id the proxy exposes, e.g. grok-4.5 or Antigravity/Gemini.
# OPENAI_BASE_URL=
# If the proxy requires a client key, put it in OPENAI_API_KEY (or the per-agent
# openai_api_key_env). With only OPENAI_BASE_URL set, a local placeholder key is used.

# Reply freshness gate (default on). Before posting, peer/allowed-human
# messages that arrived mid-turn trigger exactly one re-decide pass, and a
# verbatim duplicate of the latest non-self message is never posted.
# Local transcript only (zero extra Slack API calls); set 0 to disable.
# FRESHNESS_RECHECK=1

# Provider rate-limit cooldown. A rate-limited AI turn (429 / usage limit /
# overloaded; Retry-After honored) arms a back-off shared by all local agents
# on the same provider account, starting at the base and doubling per
# consecutive strike up to the max. The turn is retried once only when no
# side-effecting tool ran and the provider's reset fits within 15 minutes.
# PROVIDER_COOLDOWN_BASE_SECONDS=60
# PROVIDER_COOLDOWN_MAX_SECONDS=480

# Adaptive turn pacer (node-wide). Provider turn starts across all local
# agents are spaced by an adaptive interval: base doubling on each
# rate-limited turn up to the max, halving back after enough clean turns.
# Base 0 disables pacing.
# PROVIDER_PACER_BASE_SECONDS=0.5
# PROVIDER_PACER_MAX_SECONDS=8
# PROVIDER_PACER_CLEAN_TURNS=5

# Socket Mode delivery gap. When a socket stays down (or the host sleeps)
# longer than this, Slack's redelivery window may have passed, so every warm
# shared transcript is revalidated from the thread root on its next read.
# SOCKET_GAP_REVALIDATE_SECONDS=120

# Agents open PRs; humans merge. Agent runtimes get guard shims on PATH that
# refuse `gh pr merge`, the merge API, and pushes to these branches (comma
# list; default main,master). A guard rail for a shared GitHub identity, not a
# security boundary: use branch protection and an agent identity without
# merge rights for that.
# AGENT_PROTECTED_BRANCHES=main,master
